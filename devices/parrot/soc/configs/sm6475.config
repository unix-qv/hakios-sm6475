# HakiOS fragment: the Qualcomm SM6475 family (Snapdragon 6 Gen 3, "parrot") -- what is true of the SoC, whatever phone it is in.
# 8 cores: 4x Cortex-A78 (big, cores 4-7) + 4x Cortex-A55 (little, cores 0-3). The biggest is core 7.
# Temperature sensors, chip-identity memory and the PMIC arbiter are at the addresses of this family.
CONFIG_SOC="sm6475"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
